# ============================================================
# CitizenShift — environment configuration
#
# Copy to `.env.local` and fill in real values.
# `.env.local` is git-ignored — NEVER commit real credentials.
# This file contains EMPTY placeholders only and is safe to commit.
# ============================================================

# ------------------------------------------------------------
# Supabase — Phase 2
# ------------------------------------------------------------
# Project URL, e.g. https://<PROJECT-REF>.supabase.co
# The project reference shown in the admin panel is DERIVED from this URL.
# Do not add a separate PROJECT_REF variable — keep one source of truth.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (anon) key — safe to expose to the browser.
# Modern: sb_publishable_...   Legacy fallback: the anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only base URL. Often identical to NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=

# Secret (service_role) key — SERVER ONLY. Never referenced by any client
# component, never returned by an API route, never logged.
# Modern: sb_secret_...   Legacy fallback: the service_role key.
SUPABASE_SECRET_KEY=

# Site URL used for auth redirects / cookie scope.
# Production: https://citizenshift.us
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only allowlist of Supabase Auth user UUIDs granted admin access.
# Comma-separated. Used by /admin/* routes for authorization.
# NEVER make this client-editable or derive it from user metadata.
CITIZENSHIFT_ADMIN_USER_IDS=

# ------------------------------------------------------------
# Legislation proxy — existing, unchanged
# ------------------------------------------------------------
# Upstream legislation service that the rebuilt experience proxies server-side.
# Visitors only ever talk to this domain.
LEGISLATION_UPSTREAM_URL=https://citizenshift.vercel.app

# Firecrawl (optional, research tooling only) — supplied at build/ops time, never in the bundle.
FIRECRAWL_API_KEY=
